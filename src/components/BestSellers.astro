---
/**
 * Best sellers.
 *
 * Driven entirely by `"best_seller": true` in products.json — the site never
 * guesses. If nothing is flagged, the section does not render at all, rather
 * than inventing a ranking.
 */
import ProductCard from './ProductCard.astro';
import T from './T.astro';
import { bestSellers } from '../lib/catalog';
---

{bestSellers.length > 0 && (
  <section class="sellers" aria-labelledby="sellers-h">
    <div class="wrap">
      <header class="head" data-reveal="fade">
        <h2 class="h" id="sellers-h"><T k="bestSellers.title" /></h2>
        <p class="sub"><T k="bestSellers.sub" /></p>
      </header>

      <ul class="grid">
        {bestSellers.map((p, i) => (
          <li data-reveal data-reveal-delay={(i % 3) * 80}>
            <ProductCard product={p} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .sellers {
    padding-block: var(--s8);
    background: var(--gray-50);
    border-block: 1px solid var(--border);
  }

  .head { margin-block-end: var(--s6); }

  .h {
    font-size: var(--fs-2xl);
    text-align: start;
  }

  .sub {
    margin-block-start: var(--s2);
    color: var(--gray-700);
    font-size: var(--fs-base);
    text-align: start;
  }

  .grid {
    display: grid;
    gap: var(--s5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 560px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: var(--s6); }
    .h { font-size: var(--fs-3xl); }
  }
</style>
