---
/**
 * Featured instruments — a static, always-side-by-side row of three panels
 * on a navy band. Deliberately not scroll-driven: it used to pin the section
 * and step through panels one at a time as the visitor scrolled, but that
 * cost more attention than three products next to each other justified.
 */
import { Image } from 'astro:assets';
import { bySlug, heroFor, altFor, benefit } from '../lib/catalog';
import { formatPrice, t } from '../i18n/strings';

const SEQUENCE = ['iris-scissors-red-curved', 'iris-scissors-rainbow', 'needle-holder-halsey-tc-12-5cm'];

const panels = SEQUENCE.map((slug) => {
  const product = bySlug(slug);
  if (!product) throw new Error(`[showcase] unknown product "${slug}"`);
  return {
    product,
    hero: heroFor(slug),
    benefitAr: benefit(product, 'ar'),
    benefitEn: benefit(product, 'en'),
    benefitKu: benefit(product, 'ku'),
  };
});
---

<section class="showcase" aria-label="Featured instruments">
  <div class="wrap">
    <p class="mostordered">
      <span data-t="ar" lang="ar" dir="rtl">{t['showcase.mostOrdered'].ar}</span><span data-t="en"
        lang="en" dir="ltr">{t['showcase.mostOrdered'].en}</span><span data-t="ku" lang="ku"
        dir="rtl">{t['showcase.mostOrdered'].ku}</span>
    </p>
    <div class="glowbox">
    <ul class="panels">
      {panels.map(({ product: p, hero, benefitAr, benefitEn, benefitKu }, i) => (
        <li class="panel">
          <a class="panel-shot" href={`/product/${p.slug}`} tabindex="-1" aria-hidden="true">
            <Image
              src={hero}
              alt={altFor(p, hero, 0)}
              width={480}
              widths={[320, 420, 480]}
              sizes="(min-width: 900px) 300px, 70vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              format="webp"
              quality={80}
            />
          </a>

          <div class="panel-copy">
            <h2 class="panel-name name-ar" data-t="ar" lang="ar" dir="rtl">{p.name_ar}</h2>
            <p class="panel-name-en name-en" data-t="en" lang="en" dir="ltr">{p.name_en}</p>
            <h2 class="panel-name name-ar" data-t="ku" lang="ku" dir="rtl">{p.name_ku ?? p.name_en}</h2>
            {(benefitAr || benefitEn || benefitKu) && (
              <p class="panel-benefit">
                <span data-t="ar">{benefitAr}</span><span data-t="en">{benefitEn}</span><span
                  data-t="ku">{benefitKu ?? benefitEn}</span>
              </p>
            )}
            <p class="panel-price price">
              <span data-t="ar">{formatPrice(p.price_iqd, 'ar')}</span><span data-t="en"
                >{formatPrice(p.price_iqd, 'en')}</span><span data-t="ku"
                >{formatPrice(p.price_iqd, 'ku')}</span>
            </p>
            <a class="btn panel-cta" href={`/product/${p.slug}`}>
              <span data-t="ar">{t['product.addToCart'].ar}</span><span data-t="en"
                >{t['product.addToCart'].en}</span><span data-t="ku">{t['product.addToCart'].ku}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
    </div>
  </div>
</section>

<style>
  .showcase {
    background: var(--navy);
    color: var(--white);
    padding-block: var(--s8);
  }

  .mostordered {
    margin-block-end: var(--s6);
    font-size: var(--fs-xl);
    font-weight: 700;
    text-align: center;
    color: var(--white);
  }

  .glowbox {
    border-radius: var(--radius);
    padding: var(--s6);
    box-shadow: 0 0 0 1px rgb(90 160 255 / 35%), 0 0 24px 4px rgb(70 140 255 / 25%);
    animation: glow-pulse 2.8s ease-in-out infinite;
  }
  @keyframes glow-pulse {
    0%, 100% { box-shadow: 0 0 0 1px rgb(90 160 255 / 30%), 0 0 20px 2px rgb(70 140 255 / 18%); }
    50% { box-shadow: 0 0 0 1px rgb(120 180 255 / 55%), 0 0 40px 10px rgb(70 140 255 / 40%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .glowbox { animation: none; box-shadow: 0 0 0 1px rgb(90 160 255 / 40%), 0 0 28px 6px rgb(70 140 255 / 28%); }
  }

  .panels {
    display: grid;
    gap: var(--s8);
  }

  .panel {
    display: grid;
    gap: var(--s5);
    justify-items: center;
    text-align: center;
  }

  .panel-shot {
    display: block;
    width: min(62vw, 300px);
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: rgb(255 255 255 / 4%);
  }
  .panel-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .panel-copy {
    display: grid;
    gap: var(--s2);
    justify-items: center;
    max-width: 40ch;
  }

  .panel-name {
    font-size: var(--fs-xl);
    font-family: var(--font-ar);
    color: var(--white);
  }
  .panel-name-en {
    font-family: var(--font-en);
    font-size: var(--fs-base);
    color: var(--white);
  }
  .panel-benefit {
    font-size: var(--fs-base);
    color: var(--white);
    line-height: 1.7;
  }

  .panel-price {
    margin-block-start: var(--s2);
    font-size: var(--fs-2xl);
  }

  .panel-cta {
    margin-block-start: var(--s3);
    width: 100%;
    background: var(--white);
    color: var(--navy);
    border-color: var(--white);
  }
  .panel-cta:hover {
    background: rgb(255 255 255 / 88%);
  }

  /* Centre alignment beats the page-direction rules for this block only. */
  .panel :global(.name-ar),
  .panel :global(.name-en) { text-align: center; }

  @media (min-width: 560px) {
    .panels { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .panels { grid-template-columns: repeat(3, 1fr); gap: var(--s6); }
    .panel-shot { width: 100%; max-width: 260px; }
    .panel-name { font-size: var(--fs-2xl); }
  }
</style>
