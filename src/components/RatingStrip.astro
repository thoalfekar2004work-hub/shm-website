---
/**
 * Thin, display-only rating strip — sits right below the sticky nav, above
 * the hero. No buttons here on purpose: this is a trust signal a visitor
 * sees before scrolling, not an entry point to write or read reviews (that
 * lives in ReviewsSummary further down and on /reviews).
 */
import { STAR_PATH } from '../lib/review-shared';
---

<div class="ratingstrip" data-rating-strip hidden>
  <div class="rs-stars" aria-hidden="true">
    {Array.from({ length: 5 }).map((_, i) => (
      <span class="rs-star" data-star={i}>
        <svg class="star-bg" viewBox="0 0 24 24" width="18" height="18">
          <path d={STAR_PATH} fill="currentColor"></path>
        </svg>
        <span class="star-fg-wrap">
          <svg class="star-fg" viewBox="0 0 24 24" width="18" height="18">
            <path d={STAR_PATH} fill="currentColor"></path>
          </svg>
        </span>
      </span>
    ))}
  </div>
  <span class="rs-avg" data-avg>0.0</span>
  <span class="rs-count">(<span data-count>0</span>)</span>
</div>

<script>
  const strip = document.querySelector<HTMLElement>('[data-rating-strip]');
  const avgEl = strip?.querySelector('[data-avg]');
  const countEl = strip?.querySelector('[data-count]');
  const starRow = strip?.querySelector<HTMLElement>('.rs-stars');
  const stars = Array.from(strip?.querySelectorAll<HTMLElement>('.rs-star') ?? []);

  fetch('/api/reviews')
    .then((r) => (r.ok ? r.json() : null))
    .then((data: { average: number; count: number } | null) => {
      if (!strip || !data || !data.count) return;
      if (avgEl) avgEl.textContent = data.average.toFixed(1);
      if (countEl) countEl.textContent = String(data.count);
      stars.forEach((starEl, i) => {
        const fill = Math.max(0, Math.min(1, data.average - i));
        const fg = starEl.querySelector<HTMLElement>('.star-fg-wrap');
        if (fg) fg.style.width = `${fill * 100}%`;
        // A star that's neither fully lit nor fully dark gets a soft feathered
        // edge instead of a hard vertical cut — a straight clip through a
        // 5-point star shape reads as the star being sliced/dragged, not
        // a fade, especially once the sweep below starts scaling it.
        starEl.classList.toggle('is-partial', fill > 0 && fill < 1);
      });
      strip.hidden = false;
      initGlowSweep(starRow, stars);
    })
    .catch(() => {
      /* stays hidden — a missing rating strip is not worth surfacing an error for */
    });

  // --- moving glow + dock-style magnify — filled (gold) stars only ----------
  // Runs on its own by default, sweeping star-to-star; a real pointer takes
  // over while it's in the row and hands control back on mouseleave.
  function initGlowSweep(row: HTMLElement | null | undefined, starEls: HTMLElement[]) {
    if (!row || !starEls.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const MAX_SCALE = 1.7;
    const SIGMA = 22; // px — how far the influence spreads
    const SWEEP_MS = 4200; // one full there-and-back cycle

    function isFilled(starEl: HTMLElement): boolean {
      const fg = starEl.querySelector<HTMLElement>('.star-fg-wrap');
      return !!fg && parseFloat(fg.style.width) > 0;
    }

    function applyAt(x: number) {
      starEls.forEach((starEl) => {
        if (!isFilled(starEl)) {
          starEl.style.transform = '';
          starEl.style.filter = '';
          return;
        }
        const r = starEl.getBoundingClientRect();
        const d = x - (r.left + r.width / 2);
        const influence = Math.exp(-(d * d) / (2 * SIGMA * SIGMA));
        starEl.style.transform = `scale(${(1 + influence * (MAX_SCALE - 1)).toFixed(3)})`;
        starEl.style.filter =
          `drop-shadow(0 0 ${(2 + influence * 7).toFixed(1)}px rgb(255 200 60 / ${(0.45 + influence * 0.5).toFixed(2)}))`;
      });
    }

    let hovering = false;

    function tick(t: number) {
      if (!hovering) {
        const firstR = starEls[0].getBoundingClientRect();
        const lastR = starEls[starEls.length - 1].getBoundingClientRect();
        const minX = firstR.left + firstR.width / 2;
        const maxX = lastR.left + lastR.width / 2;
        // A sine wave (not t % duration) — continuous and self-easing at both
        // ends, so the sweep glides back and forth with no snap at the loop.
        const progress = (Math.sin((t / SWEEP_MS) * Math.PI * 2 - Math.PI / 2) + 1) / 2;
        applyAt(minX + progress * (maxX - minX));
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    row.addEventListener('mousemove', (e) => {
      hovering = true;
      applyAt(e.clientX);
    });
    row.addEventListener('mouseleave', () => {
      hovering = false;
    });
  }
</script>

<style>
  .ratingstrip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    padding-block: var(--s3);
    border-block-end: 1px solid var(--border);
    font-size: var(--fs-sm);
    background: var(--surface);
  }

  .rs-stars {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    padding-block-start: 10px;
    direction: ltr;
  }
  .rs-star {
    position: relative;
    display: inline-block;
    width: 18px;
    height: 18px;
    transform-origin: bottom center;
    /* No CSS transition here on purpose — the sweep already recomputes
       transform/filter every animation frame, so a transition on top of
       that would keep chasing a moving target and read as laggy, not
       smooth. */
  }
  .rs-star:hover {
    z-index: 1;
  }
  .rs-star svg {
    position: absolute;
    inset: 0;
    display: block;
  }
  .star-bg {
    color: var(--gray-200);
  }
  .star-fg-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    width: 0%;
    transition: width 450ms ease-out;
  }
  /* Feathered edge, partial stars only — full/empty stars stay crisp. */
  .rs-star.is-partial .star-fg-wrap {
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 calc(100% - 8px), transparent 100%);
    mask-image: linear-gradient(to right, #000 0%, #000 calc(100% - 8px), transparent 100%);
  }
  .star-fg {
    color: #ffcf4d;
    filter: drop-shadow(0 0 2px rgb(255 200 60 / 45%));
  }
  @media (prefers-reduced-motion: reduce) {
    .star-fg { filter: drop-shadow(0 0 3px rgb(255 200 60 / 70%)); }
    .star-fg-wrap { transition: none; }
  }

  .rs-avg {
    font-weight: 700;
    color: var(--text);
  }
  .rs-count {
    color: var(--gray-500);
  }
</style>
