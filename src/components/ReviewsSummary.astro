---
/**
 * Compact review summary — sits where "Best Sellers" used to be. Renders
 * empty by default and fills in from GET /api/reviews on the client, since
 * this is a static build and review counts change without a redeploy.
 */
import { t } from '../i18n/strings';
import { STAR_PATH } from '../lib/review-shared';
---

<section class="reviewswidget" aria-label="Customer reviews">
  <div class="wrap">
    <div class="box">
      <p class="rw-title">
        <span data-t="ar" lang="ar" dir="rtl">{t['reviews.title'].ar}</span><span data-t="en"
          lang="en" dir="ltr">{t['reviews.title'].en}</span><span data-t="ku" lang="ku"
          dir="rtl">{t['reviews.title'].ku}</span>
      </p>

      <div class="rw-rating" data-reviews-summary hidden>
        <div class="rw-stars" aria-hidden="true">
          {Array.from({ length: 5 }).map((_, i) => (
            <span class="rw-star" data-star={i}>
              <svg class="star-bg" viewBox="0 0 24 24" width="30" height="30">
                <path d={STAR_PATH} fill="currentColor"></path>
              </svg>
              <span class="star-fg-wrap">
                <svg class="star-fg" viewBox="0 0 24 24" width="30" height="30">
                  <path d={STAR_PATH} fill="currentColor"></path>
                </svg>
              </span>
            </span>
          ))}
        </div>
        <p class="rw-meta">
          <span class="rw-avg" data-avg>0.0</span>
          <span class="rw-count">
            (<span data-t="ar">{t['reviews.basedOn'].ar}</span><span data-t="en"
              >{t['reviews.basedOn'].en}</span><span data-t="ku">{t['reviews.basedOn'].ku}</span>
            {' '}<span data-count>0</span>{' '}
            <span data-t="ar">{t['reviews.reviewsWord'].ar}</span><span data-t="en"
              >{t['reviews.reviewsWord'].en}</span><span data-t="ku"
              >{t['reviews.reviewsWord'].ku}</span>)
          </span>
        </p>
      </div>

      <p class="rw-empty" data-reviews-empty hidden>
        <span data-t="ar">{t['reviews.noneYet'].ar}</span><span data-t="en"
          >{t['reviews.noneYet'].en}</span><span data-t="ku">{t['reviews.noneYet'].ku}</span>
      </p>

      <div class="rw-actions">
        <a class="btn btn-secondary" href="/reviews">
          <span data-t="ar">{t['reviews.seeAll'].ar}</span><span data-t="en"
            >{t['reviews.seeAll'].en}</span><span data-t="ku">{t['reviews.seeAll'].ku}</span>
        </a>
        <a class="btn btn-primary" href="/reviews#write">
          <span data-t="ar">{t['reviews.write'].ar}</span><span data-t="en"
            >{t['reviews.write'].en}</span><span data-t="ku">{t['reviews.write'].ku}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const summary = document.querySelector<HTMLElement>('[data-reviews-summary]');
  const empty = document.querySelector<HTMLElement>('[data-reviews-empty]');
  // Scoped to `summary`, not `document` — the homepage also has RatingStrip's
  // own [data-avg]/[data-count] elements, and an unscoped query would grab
  // whichever one happens to come first in the DOM.
  const avgEl = summary?.querySelector('[data-avg]');
  const countEl = summary?.querySelector('[data-count]');
  const starRow = summary?.querySelector<HTMLElement>('.rw-stars');
  const stars = Array.from(document.querySelectorAll<HTMLElement>('.rw-star'));

  fetch('/api/reviews')
    .then((r) => (r.ok ? r.json() : null))
    .then((data: { average: number; count: number } | null) => {
      if (!data || !data.count) {
        if (empty) empty.hidden = false;
        return;
      }
      if (avgEl) avgEl.textContent = data.average.toFixed(1);
      if (countEl) countEl.textContent = String(data.count);
      stars.forEach((starEl, i) => {
        const fill = Math.max(0, Math.min(1, data.average - i));
        const fg = starEl.querySelector<HTMLElement>('.star-fg-wrap');
        if (fg) fg.style.width = `${fill * 100}%`;
        // A star that's neither fully lit nor fully dark gets a soft feathered
        // edge instead of a hard vertical cut — a straight clip through a
        // 5-point star shape reads as the star being sliced/dragged, not
        // a fade, especially once the sweep below starts scaling it.
        starEl.classList.toggle('is-partial', fill > 0 && fill < 1);
      });
      if (summary) summary.hidden = false;
      initGlowSweep(starRow, stars);
    })
    .catch(() => {
      if (empty) empty.hidden = false;
    });

  // --- moving glow + dock-style magnify — filled (gold) stars only ----------
  // Runs on its own by default, sweeping star-to-star; a real pointer takes
  // over while it's in the row and hands control back on mouseleave.
  function initGlowSweep(row: HTMLElement | null | undefined, starEls: HTMLElement[]) {
    if (!row || !starEls.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const MAX_SCALE = 1.7;
    const SIGMA = 30; // px — how far the influence spreads
    const SWEEP_MS = 4200; // one full there-and-back cycle

    function isFilled(starEl: HTMLElement): boolean {
      const fg = starEl.querySelector<HTMLElement>('.star-fg-wrap');
      return !!fg && parseFloat(fg.style.width) > 0;
    }

    function applyAt(x: number) {
      starEls.forEach((starEl) => {
        if (!isFilled(starEl)) {
          starEl.style.transform = '';
          starEl.style.filter = '';
          return;
        }
        const r = starEl.getBoundingClientRect();
        const d = x - (r.left + r.width / 2);
        const influence = Math.exp(-(d * d) / (2 * SIGMA * SIGMA));
        starEl.style.transform = `scale(${(1 + influence * (MAX_SCALE - 1)).toFixed(3)})`;
        starEl.style.filter =
          `drop-shadow(0 0 ${(2 + influence * 8).toFixed(1)}px rgb(255 200 60 / ${(0.5 + influence * 0.45).toFixed(2)}))`;
      });
    }

    let hovering = false;

    function tick(t: number) {
      if (!hovering) {
        const firstR = starEls[0].getBoundingClientRect();
        const lastR = starEls[starEls.length - 1].getBoundingClientRect();
        const minX = firstR.left + firstR.width / 2;
        const maxX = lastR.left + lastR.width / 2;
        // A sine wave (not t % duration) — continuous and self-easing at both
        // ends, so the sweep glides back and forth with no snap at the loop.
        const progress = (Math.sin((t / SWEEP_MS) * Math.PI * 2 - Math.PI / 2) + 1) / 2;
        applyAt(minX + progress * (maxX - minX));
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    row.addEventListener('mousemove', (e) => {
      hovering = true;
      applyAt(e.clientX);
    });
    row.addEventListener('mouseleave', () => {
      hovering = false;
    });
  }
</script>

<style>
  .reviewswidget {
    padding-block: var(--s8);
    border-block-start: 1px solid var(--border);
    text-align: center;
  }

  .box {
    display: grid;
    justify-items: center;
    gap: var(--s4);
  }

  .rw-title {
    font-size: var(--fs-xl);
    font-weight: 700;
  }

  .rw-rating {
    display: grid;
    justify-items: center;
    gap: var(--s2);
  }

  .rw-stars {
    display: inline-flex;
    align-items: flex-end;
    gap: 6px;
    padding-block-start: 16px;
    direction: ltr;
  }

  .rw-star {
    position: relative;
    display: inline-block;
    width: 30px;
    height: 30px;
    transform-origin: bottom center;
    /* No CSS transition here on purpose — the sweep already recomputes
       transform/filter every animation frame, so a transition on top of
       that would keep chasing a moving target and read as laggy, not
       smooth. */
  }
  .rw-star:hover {
    z-index: 1;
  }
  .rw-star svg {
    position: absolute;
    inset: 0;
    display: block;
  }
  .star-bg {
    color: var(--gray-200);
  }
  .star-fg-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    width: 0%;
    transition: width 450ms ease-out;
  }
  /* Feathered edge, partial stars only — full/empty stars stay crisp. */
  .rw-star.is-partial .star-fg-wrap {
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 calc(100% - 10px), transparent 100%);
    mask-image: linear-gradient(to right, #000 0%, #000 calc(100% - 10px), transparent 100%);
  }
  .star-fg {
    color: #ffcf4d;
    filter: drop-shadow(0 0 2px rgb(255 200 60 / 50%));
  }
  @media (prefers-reduced-motion: reduce) {
    .star-fg { filter: drop-shadow(0 0 4px rgb(255 200 60 / 75%)); }
    .star-fg-wrap { transition: none; }
  }

  .rw-meta {
    font-size: var(--fs-base);
    color: var(--gray-700);
  }
  .rw-avg {
    font-weight: 700;
    font-size: var(--fs-lg);
    color: var(--text);
  }

  .rw-empty {
    color: var(--gray-700);
    font-size: var(--fs-base);
  }

  .rw-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s3);
    margin-block-start: var(--s2);
  }
</style>
