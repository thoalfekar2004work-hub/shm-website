---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PromoBanner from '../components/PromoBanner.astro';
import { SITE_URL } from '../i18n/strings';

interface Props {
  /** Arabic page title. English is the served default (see the <html> tag below). */
  titleAr: string;
  titleEn: string;
  descAr: string;
  descEn: string;
  /** Kurdish title/description are optional — pages that haven't been given
   * one yet fall back to the English version rather than going blank. */
  titleKu?: string;
  descKu?: string;
  /** Overrides og:title when the unfurl headline differs from the page title. */
  ogTitle?: string;
  /** Absolute or root-relative URL of the social preview image. */
  ogImage?: string;
  ogImageAlt?: string;
  canonicalPath: string;
  noindex?: boolean;
}

const {
  titleAr,
  titleEn,
  descAr,
  descEn,
  titleKu = titleEn,
  descKu = descEn,
  ogTitle,
  ogImage,
  ogImageAlt,
  canonicalPath,
  noindex,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE_URL).href : new URL('/og-default.jpg', SITE_URL).href;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-N8RK7NLG');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111E34" />
    <!-- Real light/dark support now lives in tokens.css (html[data-theme]),
         applied before paint below — no forced color-scheme here. -->
    <meta name="color-scheme" content="light dark" />

    <title
      data-page-title-ar={titleAr}
      data-page-title-en={titleEn}
      data-page-title-ku={titleKu}>{titleEn}</title>
    <meta
      name="description"
      content={descEn}
      data-desc-ar={descAr}
      data-desc-en={descEn}
      data-desc-ku={descKu}
    />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/plex-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SHM" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle ?? titleEn} />
    <meta property="og:description" content={descEn} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />

    <script is:inline>
      // Apply the saved language before first paint so nothing flashes.
      // English is the served default; only a saved "ar" or "ku" choice
      // switches it (both are RTL). Title/description are swapped here too,
      // since they're SSR'd in English and otherwise wouldn't match a
      // returning Arabic/Kurdish visitor until the in-page toggle script ran.
      (function () {
        try {
          var l = localStorage.getItem('shm.lang');
          if (l === 'ar' || l === 'ku') {
            document.documentElement.setAttribute('lang', l);
            document.documentElement.setAttribute('dir', 'rtl');
            var titleEl = document.querySelector('title[data-page-title-' + l + ']');
            if (titleEl) document.title = titleEl.getAttribute('data-page-title-' + l);
            var descEl = document.querySelector('meta[name="description"][data-desc-' + l + ']');
            if (descEl) descEl.setAttribute('content', descEl.getAttribute('data-desc-' + l));
          }
        } catch (e) {}
      })();

      // Same idea for theme: an explicit saved choice wins, otherwise fall
      // back to the OS/browser preference — applied before paint either way.
      (function () {
        try {
          var saved = localStorage.getItem('shm.theme');
          var dark =
            saved === 'dark' ||
            (saved !== 'light' &&
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>

    <style is:global>
      /* Show only the active language — generalizes to any number of
         data-t variants, unlike a pairwise "hide the other one" rule. */
      html:not([lang='ar']) [data-t='ar'] { display: none; }
      html:not([lang='en']) [data-t='en'] { display: none; }
      html:not([lang='ku']) [data-t='ku'] { display: none; }
    </style>
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N8RK7NLG"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a class="skip-link" href="#main">
      <span data-t="ar">تخطَّ إلى المحتوى</span><span data-t="en">Skip to content</span><span
        data-t="ku">بازدان بۆ ناوەرۆک</span>
    </a>
    <PromoBanner />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initLang } from '../scripts/i18n';
      import { initThemeToggle } from '../scripts/theme';
      import { initCartBadge } from '../scripts/cart';
      import { initMotion } from '../scripts/motion';
      import { initCountdowns } from '../scripts/promo';
      initLang();
      initThemeToggle();
      initCartBadge();
      initMotion();
      initCountdowns();
    </script>
  </body>
</html>
